#!/bin/sh
# SPDX-FileCopyrightText: © 2026 Tenstorrent USA, Inc.
# SPDX-License-Identifier: Apache-2.0
#
# systemd-shutdown hook (spec 04 I88): the broker's power cycle, fired after the host OS is down.
# Installed by apply-host-config.sh into the system-shutdown directory. systemd-shutdown runs it with
# the verb ($1) once every service has stopped and the filesystems are unmounted or read-only.
#
# It acts only on a reboot the broker asked for: the broker writes REQ (epoch, reason, per-try
# timeout, then one argv word per line, the first an absolute path) before `systemctl reboot`. /run is
# empty on every boot, so a request never outlives its boot; one older than an hour is ignored too.
# With no request it does nothing and the reboot, poweroff or halt goes ahead unchanged.
#
# systemd-shutdown kills a hook still running after 90 s. The worst case here is 10 s (RAID wait)
# + 3 tries x 15 s + 2 pauses x 2 s + 25 s (power drop) = 84 s. If the cycle command fails three
# times, the hook exits and systemd-shutdown reboots warm; the broker's startup check then finds the
# device as it is and its own recovery runs again.
REQ="${TT_DEVICE_MCP_POWER_CYCLE_REQUEST:-/run/tt-device-mcp-power-cycle.request}"
FALLBACK_PID="${REQ%.request}.fallback.pid"
MAX_AGE=3600
# systemd-shutdown may hand hooks a bare environment: add the standard directories after any PATH.
PATH="${PATH:+$PATH:}/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
export PATH

say() { echo "tt-device-mcp power-cycle hook: $*" >/dev/kmsg 2>/dev/null || echo "tt-device-mcp power-cycle hook: $*" >&2; }

# The pids whose parent is one of the pids in $1, on one line; /proc/<pid>/stat's comm field may hold
# spaces or ')', so the fields are read after its last ") ".
children_of() {
    for st in /proc/[0-9]*/stat; do
        IFS= read -r s 2>/dev/null <"$st" || continue
        s=${s##*) }
        s=${s#* }
        case " $1 " in *" ${s%% *} "*)
            p=${st#/proc/}
            printf '%s ' "${p%/stat}"
            ;;
        esac
    done
}

# Stop the fallback $1 and everything it started: past its bound it is `timeout` with the cycle
# command as its child, and a SIGKILL to the pid alone would leave that child to cut power later.
# Freeze each generation before reading the next, so none forks past the sweep, then SIGKILL its
# process group (it leads one: a unit's main process does, and so does timeout) and every pid found.
stop_fallback() {
    tree=$1
    gen=$1
    while [ -n "$gen" ]; do
        kill -STOP $gen 2>/dev/null
        gen=$(children_of "$gen")
        tree="$tree $gen"
    done
    IFS= read -r s 2>/dev/null <"/proc/$1/stat" || s=
    s=${s##*) }
    s=${s#* }
    s=${s#* }
    [ "${s%% *}" = "$1" ] && kill -9 "-$1" 2>/dev/null
    kill -9 $tree 2>/dev/null
}

[ "${1:-}" = reboot ] || exit 0
[ -r "$REQ" ] || exit 0
{
    IFS= read -r at || at=
    IFS= read -r reason || reason=
    IFS= read -r try_timeout || try_timeout=
    set --
    while IFS= read -r word; do set -- "$@" "$word"; done
} <"$REQ"
[ "$#" -gt 0 ] || { say "request has no command; not cycling"; exit 0; }
now=$(date +%s 2>/dev/null) || now=0
case "$at" in '' | *[!0-9]*) say "request has no time; not cycling"; exit 0 ;; esac
[ "$now" -ge "$at" ] && [ $((now - at)) -le "$MAX_AGE" ] || { say "request is stale; not cycling"; exit 0; }
case "$try_timeout" in '' | *[!0-9]*) try_timeout=15 ;; esac
[ "$try_timeout" -ge 5 ] || try_timeout=5
[ "$try_timeout" -le 15 ] || try_timeout=15
TT_DEVICE_MCP_POWER_CYCLE_REASON="$reason"
export TT_DEVICE_MCP_POWER_CYCLE_REASON

# The broker's fallback survives the killall (its argv[0] starts with '@'); stop it by the pid it
# recorded, first, before any wait here, so it can never cut power while this hook runs: the cycle
# fires only from this hook, after the OS is down.
if [ -r "$FALLBACK_PID" ]; then
    IFS= read -r fpid <"$FALLBACK_PID" || fpid=
    case "$fpid" in
    '' | *[!0-9]*) ;;
    *)
        case "$(head -c 31 "/proc/$fpid/cmdline" 2>/dev/null)" in
        @tt-device-mcp-power-cycle-*)
            stop_fallback "$fpid"
            say "stopped the fallback (pid $fpid) and its children"
            ;;
        esac
        ;;
    esac
fi

say "power-cycling the host now: $reason"
# The filesystems are read-only by now; never block on a flush that cannot finish.
sync &
# Hooks run in parallel: let the RAID arrays finish marking themselves clean before power goes.
command -v mdadm >/dev/null 2>&1 && timeout 10 mdadm --wait-clean --scan >/dev/null 2>&1
try=1
while [ "$try" -le 3 ]; do
    if timeout "$try_timeout" "$@"; then
        # Power is about to drop; do not race systemd-shutdown into a warm reboot meanwhile.
        sleep 25
        exit 0
    fi
    say "cycle command failed (try $try)"
    [ "$try" -lt 3 ] && sleep 2
    try=$((try + 1))
done
say "cycle command failed 3 times; the reboot continues warm"
exit 1
